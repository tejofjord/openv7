  <!-- <map value="0xB0 0xNN" name="strip_search"  /> --><!-- needle strip -->
  <!-- <map value="0x90 0xNN" name="pad_1"         /> --><!-- hot cues 1-5 -->
  <!-- <map value="0xB0 0xNN" name="browser_scroll"/> --><!-- library knob -->

  <!-- ================= OUTPUT (host -> device) ================= -->
  <!-- Motor + LEDs are driven by sending MIDI to the "Numark V7" destination.
       Motor command set (deck A, status 0xB0), verified spins the platter:
         0x43 = soft start   0x44 = brake    0x41 = instant start
         0x45 = RPM (00=33, 01=45)           0x46 = direction (00 fwd / 01 rev)
       See docs/PROTOCOL.md for the full set. Output mappings are next. -->

</device>
