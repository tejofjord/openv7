<!--
  Numark V7 — VirtualDJ device definition (STARTER)  ·  via OpenV7

  Use with the OpenV7 userspace bridge running (the V7 appears as the MIDI
  device "Numark V7"). This file maps the controls verified from captured USB
  traffic and leaves the rest as TODO placeholders to confirm with MIDI-learn.

  The button/pad message numbers below are NOT yet confirmed on hardware —
  run `openv7 -v`, press each control, and fill in the real values, then send
  a PR. See ../../docs/PROTOCOL.md. If the schema needs tweaking for your
  VirtualDJ version, prefer MIDI-learn (see README.md) and update this file.
-->
<device name="Numark V7" author="OpenV7" type="MIDI" decks="1"
        description="Numark V7 motorized controller via the OpenV7 userspace bridge">

  <!-- ================= VERIFIED (captured on hardware) ================= -->

  <!-- Motorized platter: 7-bit wrapping position counter, 3600 ticks/rev.
       Deck A = CC 0x00, deck B = CC 0x02, paired with a 0xE0 pitch-bend
       "timestamp" for velocity (clock 2,822,400 Hz). -->
  <map value="0xB0 0x00" name="jog"  />
  <map value="0xE0 0x00" name="jog_touch" />   <!-- TODO: refine pitch-bend timestamp handling -->

  <!-- ============= TODO — confirm with `openv7 -v` + MIDI-learn ============= -->
